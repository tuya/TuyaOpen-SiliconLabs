+++ b/boards/SiWx917/common/audio/tdd_audio_no_codec.c
@@ -0,0 +1,366 @@
+#include "tdl_audio_driver.h"
+#include "tdd_audio_no_codec.h"
+
+#include "tal_memory.h"
+#include "tal_log.h"
+#include "tal_system.h"
