#!/usr/bin/env bash

set -euxo pipefail

# ==============================================================================
# Bash definitions

if [[ -n ${BASH_SOURCE[0]} ]]; then
    script_path="${BASH_SOURCE[0]}"
else
    script_path="$0"
fi
script_dir="$(realpath "$(dirname "${script_path}")")"
repo_dir="$(dirname "${script_dir}")"

# download_file, die
source "${script_dir}/util"

# ==============================================================================
install_packages_apt()
{
    echo 'Installing script dependencies...'

    # Install dependencies
    sudo apt-get update
    apt_packages=(
        ccache
        coreutils
        git
        git-lfs
        openjdk-21-jdk
        openjdk-21-jre-headless
        ninja-build
        python3-pip
        python3-setuptools
        unzip
        wget
        xz-utils
        bzip2
    )
    sudo apt-get --no-install-recommends install -y "${apt_packages[@]}"
}

install_packages_opkg()
{
    echo 'opkg not supported currently' && false
}

install_packages_rpm()
{
    echo 'rpm not supported currently' && false
}

install_packages_brew()
{
    echo 'Installing script dependencies...'

    brew_packages=(
        ccache
        coreutils
        git
        git-lfs
        grep
        ninja-build
        openjdk@21
        unzip
        wget
        bzip2
    )
    brew install "${brew_packages[@]}"
}

install_packages_source()
{
    echo 'source not supported currently' && false
}

install_packages_pip3()
{
    pip3 install --no-cache-dir --upgrade -r "${repo_dir}/requirements.txt"
}

install_packages()
{
    PM=source
    if command -v apt-get; then
        PM=apt
    elif command -v rpm; then
        PM=rpm
    elif command -v opkg; then
        PM=opkg
    elif command -v brew; then
        PM=brew
    fi

    # Two situations where nothing can be installed here:
    #   - no package manager at all (Windows under Git Bash leaves PM=source,
    #     and install_packages_source just fails)
    #   - apt but sudo wants a password, as on a CI runner; `sudo apt-get`
    #     then blocks on a prompt nobody answers and `set -e` tears the whole
    #     bootstrap down before it reaches the toolchain install
    #
    # Carrying on is usually right, since those hosts normally already have
    # what is needed. But carrying on blindly only moves the failure to an
    # error that says nothing about the cause, so check what the rest of the
    # bootstrap actually uses and stop here naming anything absent.
    local skip_reason=""
    if [ "${PM}" = "source" ]; then
        skip_reason="no supported package manager on this host"
    elif [ "${PM}" = "apt" ] && ! sudo -n true 2> /dev/null; then
        skip_reason="sudo is not available without a password"
    fi

    if [ -n "${skip_reason}" ]; then
        # Archive tools differ by host: Windows takes both the toolchain and
        # the nested Commander build as zips, so it needs neither xz nor bzip2.
        #
        # Two tools are on no list: unzip, because script/util falls back to
        # python for zip archives, and java, because install_jre fetches a JRE
        # when the host has none.
        local required
        case "$(uname -s)" in
            MINGW* | MSYS* | CYGWIN*) required="git" ;;
            *) required="git tar bzip2 xz" ;;
        esac

        local missing=""
        local tool
        for tool in ${required}; do
            command -v "${tool}" > /dev/null 2>&1 || missing="${missing} ${tool}"
        done
        # Either spelling will do; the Windows venv ships python.exe only.
        if ! command -v python3 > /dev/null 2>&1 && ! command -v python > /dev/null 2>&1; then
            missing="${missing} python"
        fi
        if ! command -v curl > /dev/null 2>&1 && ! command -v wget > /dev/null 2>&1; then
            missing="${missing} curl-or-wget"
        fi

        set +x
        echo ""
        echo "Skipping system package install: ${skip_reason}."
        if [ -n "${missing}" ]; then
            echo ""
            echo " ** ERROR: the bootstrap cannot continue -- missing:${missing}"
            echo "    Install them and run this again."
            echo ""
            exit 1
        fi
        echo "Everything the bootstrap needs is already present."
        echo ""
        set -x
        return 0
    fi

    install_packages_$PM
}

do_bootstrap_silabs()
{
    echo "Bootstrapping silabs"
    "${repo_dir}"/script/bootstrap_silabs
}

install_arm_toolchain()
{
    # The toolchain goes into platform/tools/, one level above this platform,
    # because every TuyaOpen platform shares that directory: T5AI and GD32 both
    # resolve theirs as ${PLATFORM_PATH}/../tools/<name>, and the CI runner
    # pre-seeds it with the tarballs. Installing into our own tools/toolchain
    # meant re-downloading 155 MB that was already sitting right next door.
    #
    # Linux and Windows therefore use the same gcc-arm-none-eabi-10.3-2021.10 as
    # the other platforms, so a seeded tarball is a hit. macOS stays on
    # arm-gnu-toolchain-12.2: 10.3 ships no native arm64 build and would run
    # under Rosetta on Apple silicon.
    local release tarball_name url_base
    case "$(uname -s)" in
        Darwin)
            if [ "$(uname -m)" = "arm64" ]; then
                release="arm-gnu-toolchain-12.2.rel1-darwin-arm64-arm-none-eabi"
            else
                release="arm-gnu-toolchain-12.2.rel1-darwin-x86_64-arm-none-eabi"
            fi
            tarball_name="${release}.tar.xz"
            url_base="https://developer.arm.com/-/media/Files/downloads/gnu/12.2.rel1/binrel"
            ;;
        MINGW* | MSYS* | CYGWIN*)
            release="gcc-arm-none-eabi-10.3-2021.10"
            tarball_name="${release}-win32.zip"
            url_base="https://armkeil.blob.core.windows.net/developer/Files/downloads/gnu-rm/10.3-2021.10"
            ;;
        *)
            release="gcc-arm-none-eabi-10.3-2021.10"
            if [ "$(uname -m)" = "aarch64" ]; then
                tarball_name="${release}-aarch64-linux.tar.bz2"
            else
                tarball_name="${release}-x86_64-linux.tar.bz2"
            fi
            url_base="https://armkeil.blob.core.windows.net/developer/Files/downloads/gnu-rm/10.3-2021.10"
            ;;
    esac

    local url=${1-"${url_base}/${tarball_name}"}
    local extract_dir=${2-"${release}"}
    local toolchain_dir=${3-"${repo_dir}/../tools"}

    # Already extracted? The binary carries a .exe on Windows, so testing the
    # bare name there always misses and the whole archive gets fetched again.
    local gcc_exe="${toolchain_dir}/${extract_dir}/bin/arm-none-eabi-gcc"
    case "$(uname -s)" in
        MINGW* | MSYS* | CYGWIN*) gcc_exe="${gcc_exe}.exe" ;;
    esac
    if [ -x "${gcc_exe}" ]; then
        echo "'arm-none-eabi-gcc' found. Skipping GNU ARM Embedded toolchain install"
        "${gcc_exe}" --version
        return
    fi

    echo 'Installing GNU ARM Embedded Toolchain...'
    mkdir -p "${toolchain_dir}/${extract_dir}"

    # Keep the upstream file name, and leave the archive in place afterwards.
    # That is what lets an already-present tarball be recognised, both here and
    # on the next run; a generic "gcc-arm.tar.xz" could never match what CI
    # seeds the shared directory with.
    local tarball="${toolchain_dir}/${tarball_name}"
    if [ -f "${tarball}" ]; then
        echo "Found ${tarball_name} already present. Skipping download"
    else
        download_file "${url}" "${tarball}"
    fi

    # Extract. The Windows build ships as a zip, which has no --strip-components
    # equivalent, so flatten the single top-level directory afterwards instead.
    case "${tarball_name}" in
        *.zip)
            local staging="${toolchain_dir}/.unzip-${extract_dir}"
            rm -rf "${staging}"
            extract_zip "${tarball}" "${staging}"
            local inner
            inner=$(find "${staging}" -mindepth 1 -maxdepth 1 -type d | head -n 1)
            if [ -z "${inner}" ]; then
                die "unexpected layout inside ${tarball_name}"
            fi
            cp -R "${inner}/." "${toolchain_dir}/${extract_dir}/"
            rm -rf "${staging}"
            ;;
        *)
            tar xf "${tarball}" --directory "${toolchain_dir}/${extract_dir}" --strip-components=1
            ;;
    esac

    # Link if root
    if [ "$EUID" -eq 0 ]; then
        ln -s -f "${toolchain_dir}"/"${extract_dir}"/bin/* /usr/local/bin/
        ls -alh /usr/local/bin/arm*
    else
        set +x
        echo ""
        echo "The bootstrap script was run without sudo"
        echo ""
        echo "Make sure to add '${toolchain_dir}/${extract_dir}/bin/' to PATH"
        echo ""
        set -x
    fi
}

install_jre()
{
    local jre_dir="${repo_dir}/tools/jre"

    if command -v java > /dev/null 2>&1; then
        echo "'java' found on PATH. Skipping JRE install"
        return 0
    fi
    if [ -x "${jre_dir}/bin/java" ]; then
        echo "Bundled JRE already installed at ${jre_dir}"
        return 0
    fi

    # slc is a Java application, and the apt step that would have installed a
    # JDK is skipped wherever sudo needs a password -- a CI runner, typically.
    # Fetch a JRE into tools/ the same way the ARM toolchain is fetched rather
    # than asking every such host to install one by hand.
    #
    # 21, not 17: nine of slc's own plugin jars are compiled to class file
    # version 65 with Multi-Release unset -- com.silabs.uc.cli.product and
    # com.silabs.ss.framework.uc.extension among them -- so a 17 runtime cannot
    # load them. It fails as an UnsupportedClassVersionError that slc reports
    # only as "An error has occurred. See the log file", which is what made a
    # CI run spend 51 minutes to say nothing. install_packages_apt already asks
    # for openjdk-21; the openjdk@17 on the brew list is the stale entry.
    local os arch ext
    case "$(uname -s)" in
        Darwin) os="mac" ext="tar.gz" ;;
        MINGW* | MSYS* | CYGWIN*) os="windows" ext="zip" ;;
        *) os="linux" ext="tar.gz" ;;
    esac
    case "$(uname -m)" in
        x86_64 | amd64) arch="x64" ;;
        aarch64 | arm64) arch="aarch64" ;;
        *)
            echo " ** ERROR: no Adoptium JRE published for $(uname -m)" >&2
            exit 1
            ;;
    esac

    local url="https://api.adoptium.net/v3/binary/latest/21/ga/${os}/${arch}/jre/hotspot/normal/eclipse"
    local staging="${repo_dir}/tools/.jre-staging"
    local archive="${staging}/jre.${ext}"

    echo "Installing Temurin JRE 21 (${os}/${arch}) ..."
    rm -rf "${staging}"
    mkdir -p "${staging}"

    download_file "${url}" "${archive}"

    case "${ext}" in
        tar.gz) tar xzf "${archive}" -C "${staging}" ;;
        zip) extract_zip "${archive}" "${staging}" ;;
    esac

    # The archive holds one top-level jdk-21.x.y+z-jre directory; lift its
    # contents so the path stays tools/jre regardless of the exact version.
    local inner
    inner=$(find "${staging}" -mindepth 1 -maxdepth 1 -type d | head -n 1)
    if [ -z "${inner}" ]; then
        echo " ** ERROR: unexpected layout inside the JRE archive" >&2
        exit 1
    fi
    mkdir -p "${jre_dir}"
    cp -R "${inner}/." "${jre_dir}/"
    rm -rf "${staging}"

    if [ ! -x "${jre_dir}/bin/java" ]; then
        echo " ** ERROR: ${jre_dir}/bin/java is missing after install" >&2
        exit 1
    fi
    "${jre_dir}/bin/java" -version
}

main()
{
    if [ $# == 0 ]; then
        install_packages
        install_arm_toolchain
        install_jre
        install_packages_pip3
        do_bootstrap_silabs
    elif [ "$1" == 'packages' ]; then
        install_packages
    elif [ "$1" == 'arm_toolchain' ]; then
        shift 1
        install_arm_toolchain "$@"
    elif [ "$1" == 'python' ]; then
        install_packages_pip3
    elif [ "$1" == 'jre' ]; then
        install_jre
    elif [ "$1" == 'silabs' ]; then
        do_bootstrap_silabs
    else
        echo >&2 "Unsupported action: $1. Supported: packages, arm_toolchain, jre, python, silabs"
        # 128 for Invalid arguments
        exit 128
    fi

    echo "Bootstrap completed successfully."
    exit 0
}

main "$@"
