#!/usr/bin/env bash

set -euxo pipefail

# ==============================================================================
# Bash definitions

if [[ -n ${BASH_SOURCE[0]} ]]; then
    script_path="${BASH_SOURCE[0]}"
else
    script_path="$0"
fi
script_dir="$(realpath "$(dirname "${script_path}")")"
repo_dir="$(dirname "${script_dir}")"

# ==============================================================================

install_slc_cli()
{
    [ -n "${SLC_INSTALL_DIR-}" ] || SLC_INSTALL_DIR="${repo_dir}/tools/slc"

    # Install slc-cli
    local os_type
    if [[ $OSTYPE == "linux"* ]]; then
        os_type="linux"
    elif [[ $OSTYPE == "darwin"* ]]; then
        os_type="mac"
    fi

    local zip_url="https://www.silabs.com/documents/login/software/slc_cli_${os_type}.zip"
    mkdir -p "${SLC_INSTALL_DIR}"
    pushd "${SLC_INSTALL_DIR}"
    local zip_path="./slc_cli.zip"
    wget "${zip_url}" -O "${zip_path}"
    unzip -q -o "${zip_path}" -d "$(dirname ${zip_path})" && rm "${zip_path}"
    popd

    # Link if root
    if [ "$EUID" -eq 0 ]; then
        ln -s -f "${SLC_INSTALL_DIR}"/slc_cli/slc* /usr/local/bin/
        ls -alh /usr/local/bin/slc
    else
        set +x
        echo ""
        echo "The bootstrap script was run without sudo"
        echo ""
        echo "Make sure to add '${SLC_INSTALL_DIR}/slc_cli/' to PATH"
        echo ""
        set -x
    fi
}

install_commander()
{
    [ -n "${COMMANDER_INSTALL_DIR-}" ] || COMMANDER_INSTALL_DIR="${repo_dir}/tools/commander"

    # Install Commander
    local os_type
    if [[ $OSTYPE == "linux"* ]]; then
        os_type="Linux"
    elif [[ $OSTYPE == "darwin"* ]]; then
        os_type="mac"
    fi

    local zip_url="https://www.silabs.com/documents/login/software/SimplicityCommander-${os_type}.zip"
    mkdir -p "${COMMANDER_INSTALL_DIR}"
    pushd "${COMMANDER_INSTALL_DIR}"
    local zip_path="./commander.zip"
    wget "${zip_url}" -O "${zip_path}"
    unzip -q -o "${zip_path}" -d "$(dirname ${zip_path})" && rm "${zip_path}"
    commander_tar_bz=$(find SimplicityCommander-Linux/ -name 'Commander_linux_x86_64_*.tar.bz' | head -n 1)
    if [[ -n "$commander_tar_bz" ]]; then
        tar -xjf "$commander_tar_bz" -C ..
    fi
    rm -r SimplicityCommander-Linux
    popd
}

main()
{
    install_commander
    install_slc_cli
}

main
