#!/usr/bin/env bash

set -euxo pipefail

# ==============================================================================
# Bash definitions

if [[ -n ${BASH_SOURCE[0]} ]]; then
    script_path="${BASH_SOURCE[0]}"
else
    script_path="$0"
fi
script_dir="$(realpath "$(dirname "${script_path}")")"
repo_dir="$(dirname "${script_dir}")"

# ==============================================================================

# unzip is not guaranteed: the CI runner has none, and script/bootstrap now
# skips the apt install that would provide one when sudo needs a password.
# Python is always there -- tos.py itself runs on it -- but zipfile.extract
# drops the Unix mode bits, and slc and commander have to come out executable,
# so put them back from the archive entry.
extract_zip()
{
    local zip_file="$1"
    local dest_dir="$2"

    if command -v unzip > /dev/null 2>&1; then
        unzip -q -o "${zip_file}" -d "${dest_dir}"
        return
    fi

    local py=""
    local candidate
    for candidate in python3 python; do
        if command -v "${candidate}" > /dev/null 2>&1; then
            py="${candidate}"
            break
        fi
    done
    if [ -z "${py}" ]; then
        echo " ** ERROR: need either unzip or python to extract ${zip_file}" >&2
        exit 1
    fi

    echo "unzip not found, extracting ${zip_file} with ${py}"
    "${py}" - "${zip_file}" "${dest_dir}" << 'PY'
import os
import sys
import zipfile

archive, dest = sys.argv[1], sys.argv[2]
with zipfile.ZipFile(archive) as zf:
    for entry in zf.infolist():
        path = zf.extract(entry, dest)
        mode = (entry.external_attr >> 16) & 0o777
        if mode:
            os.chmod(path, mode)
PY
}

install_slc_cli()
{
    [ -n "${SLC_INSTALL_DIR-}" ] || SLC_INSTALL_DIR="${repo_dir}/tools/slc"

    # Install slc-cli
    local os_type
    if [[ $OSTYPE == "linux"* ]]; then
        os_type="linux"
    elif [[ $OSTYPE == "darwin"* ]]; then
        os_type="mac"
    fi

    local zip_url="https://www.silabs.com/documents/login/software/slc_cli_${os_type}.zip"
    mkdir -p "${SLC_INSTALL_DIR}"
    pushd "${SLC_INSTALL_DIR}"
    local zip_path="./slc_cli.zip"
    wget "${zip_url}" -O "${zip_path}"
    extract_zip "${zip_path}" "$(dirname ${zip_path})" && rm "${zip_path}"
    popd

    # Link if root
    if [ "$EUID" -eq 0 ]; then
        ln -s -f "${SLC_INSTALL_DIR}"/slc_cli/slc* /usr/local/bin/
        ls -alh /usr/local/bin/slc
    else
        set +x
        echo ""
        echo "The bootstrap script was run without sudo"
        echo ""
        echo "Make sure to add '${SLC_INSTALL_DIR}/slc_cli/' to PATH"
        echo ""
        set -x
    fi
}

install_commander()
{
    [ -n "${COMMANDER_INSTALL_DIR-}" ] || COMMANDER_INSTALL_DIR="${repo_dir}/tools/commander"

    # Install Commander
    local os_type
    if [[ $OSTYPE == "linux"* ]]; then
        os_type="Linux"
    elif [[ $OSTYPE == "darwin"* ]]; then
        os_type="mac"
    fi

    local zip_url="https://www.silabs.com/documents/login/software/SimplicityCommander-${os_type}.zip"
    mkdir -p "${COMMANDER_INSTALL_DIR}"
    pushd "${COMMANDER_INSTALL_DIR}"
    local zip_path="./commander.zip"
    wget "${zip_url}" -O "${zip_path}"
    extract_zip "${zip_path}" "$(dirname ${zip_path})" && rm "${zip_path}"
    commander_tar_bz=$(find SimplicityCommander-Linux/ -name 'Commander_linux_x86_64_*.tar.bz' | head -n 1)
    if [[ -n "$commander_tar_bz" ]]; then
        tar -xjf "$commander_tar_bz" -C ..
    fi
    rm -r SimplicityCommander-Linux
    popd
}

main()
{
    install_commander
    install_slc_cli
}

main
