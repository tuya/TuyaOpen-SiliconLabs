#!/usr/bin/env bash

set -euxo pipefail

# ==============================================================================
# Bash definitions

if [[ -n ${BASH_SOURCE[0]} ]]; then
    script_path="${BASH_SOURCE[0]}"
else
    script_path="$0"
fi
script_dir="$(realpath "$(dirname "${script_path}")")"
repo_dir="$(dirname "${script_dir}")"

# download_file, host_arch_tag, die
source "${script_dir}/util"

# ==============================================================================

install_slc_cli()
{
    [ -n "${SLC_INSTALL_DIR-}" ] || SLC_INSTALL_DIR="${repo_dir}/tools/slc"

    # Install slc-cli. All three names verified to serve a zip on silabs.com.
    local os_type
    if [[ $OSTYPE == "linux"* ]]; then
        os_type="linux"
    elif [[ $OSTYPE == "darwin"* ]]; then
        os_type="mac"
    elif [[ $OSTYPE == "msys"* || $OSTYPE == "cygwin"* || $OSTYPE == "win32" ]]; then
        os_type="windows"
    else
        echo " ** ERROR: no slc-cli build for OSTYPE=${OSTYPE}" >&2
        exit 1
    fi

    local zip_url="https://www.silabs.com/documents/login/software/slc_cli_${os_type}.zip"
    mkdir -p "${SLC_INSTALL_DIR}"
    pushd "${SLC_INSTALL_DIR}"
    local zip_path="./slc_cli.zip"
    download_file "${zip_url}" "${zip_path}"
    extract_zip "${zip_path}" "$(dirname ${zip_path})" && rm "${zip_path}"
    popd

    # Link if root
    if [ "$EUID" -eq 0 ]; then
        ln -s -f "${SLC_INSTALL_DIR}"/slc_cli/slc* /usr/local/bin/
        ls -alh /usr/local/bin/slc
    else
        set +x
        echo ""
        echo "The bootstrap script was run without sudo"
        echo ""
        echo "Make sure to add '${SLC_INSTALL_DIR}/slc_cli/' to PATH"
        echo ""
        set -x
    fi
}

install_commander()
{
    [ -n "${COMMANDER_INSTALL_DIR-}" ] || COMMANDER_INSTALL_DIR="${repo_dir}/tools/commander"

    # Install Commander
    #
    # The outer zip is per-OS; inside it sits one archive per host architecture,
    # and for each a full build plus a CLI-only build, so both axes have to be
    # selected or the wrong binaries get installed.
    #
    # Prefer Commander-cli. The full build links Qt5Gui/Qt5Widgets, which pull
    # libGL/libX11/libxcb in from the host, so it cannot even reach main() on a
    # headless container -- a CI runner dies with "libGL.so.1: cannot open
    # shared object file" after the firmware has already compiled and linked.
    # The CLI build links only Qt5Core/Network/SerialPort, needs no graphics
    # libraries at all, and its postbuild output is byte-identical (verified:
    # rps/hex/s37/isp.bin sha256 all match the full build).
    local os_type inner_platform exe_suffix=""
    if [[ $OSTYPE == "linux"* ]]; then
        os_type="Linux"
        inner_platform="linux_$(host_arch_tag)"
    elif [[ $OSTYPE == "msys"* || $OSTYPE == "cygwin"* || $OSTYPE == "win32" ]]; then
        os_type="Windows"
        inner_platform="win32_x64"
        exe_suffix=".exe"
    elif [[ $OSTYPE == "darwin"* ]]; then
        # One universal archive, so no arch tag. The outer zip does exist at
        # this URL pattern -- an earlier revision of this script claimed a 404
        # and refused to run on macOS; SimplicityCommander-Mac.zip answers 200.
        os_type="Mac"
        inner_platform="osx"
    else
        echo " ** ERROR: Simplicity Commander install is not supported on OSTYPE=${OSTYPE}" >&2
        exit 1
    fi

    local zip_url="https://www.silabs.com/documents/login/software/SimplicityCommander-${os_type}.zip"
    mkdir -p "${COMMANDER_INSTALL_DIR}"
    pushd "${COMMANDER_INSTALL_DIR}"

    local staging="./.staging"
    rm -rf "${staging}"
    mkdir -p "${staging}"

    local zip_path="${staging}/commander.zip"
    download_file "${zip_url}" "${zip_path}"
    extract_zip "${zip_path}" "${staging}" && rm "${zip_path}"

    # Pick this host's archive by name. Globbing without the platform tag would
    # match any of the variants Linux ships and install, say, an aarch32 build
    # on x86_64. "Commander_" does not match "Commander-cli_", so the two
    # patterns stay disjoint and the loop order is what selects the CLI build.
    local nested prefix
    for prefix in "Commander-cli" "Commander"; do
        nested=$(find "${staging}" \( -name "${prefix}_${inner_platform}_*.tar.bz*" \
            -o -name "${prefix}_${inner_platform}_*.zip" \) | head -n 1)
        [ -n "${nested}" ] && break
    done
    if [ -z "${nested}" ]; then
        echo " ** ERROR: no Commander[-cli]_${inner_platform}_* archive inside ${zip_url}" >&2
        echo "    extracted contents were:" >&2
        find "${staging}" -maxdepth 2 >&2
        exit 1
    fi

    # Unpack into the staging area, then lift the contents up: the archive's own
    # top-level folder is named differently on every platform ("commander" on
    # Linux, "Simplicity Commander" on Windows), so extracting in place would
    # scatter the binaries to a different path per OS.
    local inner="${staging}/unpacked"
    mkdir -p "${inner}"
    case "${nested}" in
        *.tar.bz*) tar -xjf "${nested}" -C "${inner}" ;;
        *.zip) extract_zip "${nested}" "${inner}" ;;
    esac

    local top
    top=$(find "${inner}" -mindepth 1 -maxdepth 1 -type d | head -n 1)
    if [ -z "${top}" ]; then
        echo " ** ERROR: unexpected layout inside $(basename "${nested}")" >&2
        exit 1
    fi

    # macOS ships an application bundle, everything else a plain directory:
    #
    #   Linux    commander/{commander-cli,lib,...}
    #   Windows  Simplicity Commander/{commander-cli.exe,...}
    #   macOS    Commander-cli.app/Contents/MacOS/commander-cli
    #            Commander-cli.app/Contents/Frameworks/*.dylib
    #
    # The bundle has to stay whole: its binary finds those dylibs through
    # @executable_path/../Frameworks, so lifting Contents/ up one level (which
    # `cp -R "${top}/."` does) leaves a binary that cannot start -- and the
    # verification below then fails with nothing to point at. Copy the bundle
    # as a unit and let the symlink step give it the usual entry point.
    case "${top}" in
        *.app)
            cp -R "${top}" .
            local bundle
            bundle=$(basename "${top}")
            local inner_bin
            for inner_bin in commander-cli commander; do
                if [ -x "${bundle}/Contents/MacOS/${inner_bin}" ]; then
                    ln -sf "${bundle}/Contents/MacOS/${inner_bin}" commander
                    break
                fi
            done
            ;;
        *)
            cp -R "${top}/." .
            ;;
    esac
    rm -rf "${staging}"

    # CMakeLists.txt and platform_flash_bridge.py both reach for a plain
    # "commander"; the CLI archive only ships "commander-cli". Link where the
    # host allows it, copy where it does not (Windows without developer mode).
    if [ ! -e "commander${exe_suffix}" ] && [ -e "commander-cli${exe_suffix}" ]; then
        ln -sf "commander-cli${exe_suffix}" "commander${exe_suffix}" \
            || cp "commander-cli${exe_suffix}" "commander${exe_suffix}"
    fi

    # Verify it actually starts, the way install_jre verifies with `java
    # -version`. Match on the banner rather than the exit status: a binary that
    # cannot resolve a shared library also exits non-zero, so the status alone
    # does not separate "ran and printed" from "never reached main". Capture
    # first instead of piping, so the result does not depend on pipefail.
    local banner
    banner="$("./commander${exe_suffix}" --version 2>&1 || true)"
    if ! printf '%s\n' "${banner}" | grep -q "Simplicity Commander"; then
        echo " ** ERROR: ${COMMANDER_INSTALL_DIR}/commander${exe_suffix} does not run." >&2
        printf '    output was: %s\n' "${banner}" >&2
        exit 1
    fi
    echo "Installed $(basename "${nested}")"

    popd
}

main()
{
    install_commander
    install_slc_cli
}

main
