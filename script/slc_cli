# ==============================================================================
# Bash definitions

if [[ -n ${BASH_SOURCE[0]} ]]; then
    script_path="${BASH_SOURCE[0]}"
else
    script_path="$0"
fi
script_dir="$(realpath "$(dirname "${script_path}")")"
repo_dir="$(dirname "${script_dir}")"

# slc-cli installation dir
[ -n "${SLC_INSTALL_DIR-}" ] || SLC_INSTALL_DIR="${repo_dir}/tools/slc"

# Set to 0 to force using slc-cli from 'third_party'/silabs/slc.
use_slc_from_path=1

# ==============================================================================

# Strip PATH entries that hijack JEP's embedded CPython (TuyaOpen .venv / .tools).
_slc_clean_path()
{
    local clean_path=""
    local part
    local old_ifs="${IFS}"
    IFS=':'
    # shellcheck disable=SC2086
    set -- ${PATH}
    IFS="${old_ifs}"
    for part in "$@"; do
        case "${part}" in
            */.venv|*/.venv/*|*/.tools/python|*/.tools/python/*)
                continue
                ;;
        esac
        if [ -z "${clean_path}" ]; then
            clean_path="${part}"
        else
            clean_path="${clean_path}:${part}"
        fi
    done
    printf '%s' "${clean_path}"
}

# Give slc an ASCII temp directory on Windows.
#
# slc renders templates through JEP, whose embedded CPython opens the render
# script with the narrow CRT fopen(). That call resolves the path in the ANSI
# code page (936 on a Chinese-locale Windows), so the script -- staged under
# java.io.tmpdir, i.e. C:\Users\<non-ASCII name>\AppData\Local\Temp by default
# -- cannot be opened, and every .jinja fails with "Couldn't open script file".
# The JVM derives java.io.tmpdir from TMP, so pointing TMP at a directory in the
# platform's own build tree keeps the path ASCII regardless of the user name.
# Linux and macOS resolve paths as UTF-8 and need none of this.
_slc_ascii_tmpdir()
{
    local tmp_dir

    case "${OSTYPE-}" in
        msys* | cygwin* | win32) ;;
        *)                       return 0 ;;
    esac

    tmp_dir="$(cygpath -m "${repo_dir}/build/.slc-tmp" 2>/dev/null)" || return 0
    if printf '%s' "${tmp_dir}" | LC_ALL=C grep -q '[^ -~]'; then
        echo "WARNING: the platform path is not ASCII (${tmp_dir})." >&2
        echo "         slc cannot generate templates from here; move the" >&2
        echo "         TuyaOpen checkout to a path without non-ASCII characters." >&2
        return 0
    fi

    mkdir -p "${repo_dir}/build/.slc-tmp" || return 0
    printf '%s' "${tmp_dir}"
}

# Wrapper function to execute an slc command
run_slc()
{
    IFS=" " read -r -a slc_args <<<"${@}"
    # TuyaOpen activates a .venv; VIRTUAL_ENV/PYTHON*/.venv-on-PATH make JEP
    # (embedded CPython inside slc) miss its own site-packages (e.g. jinja2).
    # Sanitize for SLC only. Keep eval for legacy quoting (--with=...).
    local clean_path
    clean_path="$(_slc_clean_path)"

    # slc's launcher calls a bare `java`, so a JRE fetched into tools/ by
    # install_jre has to be put on the PATH here -- nothing else adds it, and
    # the host may well have no java of its own (a CI runner without sudo, for
    # one). A system java still wins when it is present, since install_jre
    # skips the download in that case and this directory does not exist.
    local bundled_jre="${repo_dir}/tools/jre/bin"
    if [ -x "${bundled_jre}/java" ]; then
        clean_path="${bundled_jre}:${clean_path}"
    fi

    local ascii_tmp tmp_env=""
    ascii_tmp="$(_slc_ascii_tmpdir)"
    if [ -n "${ascii_tmp}" ]; then
        tmp_env="TMP=\"${ascii_tmp}\" TEMP=\"${ascii_tmp}\""
    fi

    # shellcheck disable=SC2086
    eval env -u VIRTUAL_ENV -u PYTHONHOME -u PYTHONPATH PATH=\"${clean_path}\" \
        ${tmp_env} "${slc_cmd}" "${slc_args[*]}"
}

# Locate the launcher inside an slc-cli installation.
#
# Name the launchers instead of globbing. Both slc.bat and slc are two-line
# wrappers around `java -jar slc.jar`, but `find -name 'slc*'` also matches
# bin/slc-cli/slc-cli.exe -- the Eclipse/Equinox launcher, which is a different
# program with a different command line entirely (it rejects --version and
# suggests --verbose). NTFS enumerates bin/ before slc, so on Windows
# `head -n 1` picked exactly that, and every slc call went to the wrong binary.
# ext4 happened to order slc first, which is the only reason Linux worked.
#
# The executable bit cannot be trusted either: slc.bat arrives without one, so
# the old `-perm /111` filter dropped the correct Windows entry point from the
# candidate list before ordering even mattered.
_slc_find_launcher()
{
    local root="$1" names name cand
    case "${OSTYPE-}" in
        msys* | cygwin* | win32) names="slc.bat slc" ;;
        *)                       names="slc slc.bat" ;;
    esac
    for name in ${names}; do
        for cand in "${root}/slc_cli/${name}" "${root}/${name}"; do
            if [ -f "${cand}" ]; then
                # The shell wrapper is executed directly; a zip extracted
                # without permissions would otherwise fail here.
                case "${cand}" in
                    *.bat) : ;;
                    *) [ -x "${cand}" ] || chmod +x "${cand}" 2>/dev/null || true ;;
                esac
                printf '%s' "${cand}"
                return 0
            fi
        done
    done
    return 1
}

# Find the command to use for slc
slc_init()
{
    # use_slc_from_path:
    # 0 - Use slc-cli from ${repo_dir}/slc
    # 1 - Use slc-cli or slc from PATH
    set -x

    if [ "$use_slc_from_path" -eq "1" ] && command -v slc; then
        slc_cmd="slc"
    elif [ "$use_slc_from_path" -eq "1" ] && command -v slc-cli; then
        slc_cmd="slc-cli"
    else
        echo "Searching for 'slc*' executable in '${SLC_INSTALL_DIR}'"

        # Find the slc launcher
        slc_cmd=$(_slc_find_launcher "${SLC_INSTALL_DIR}" || true)

        # Automatically download slc if not found
        if [ -z "${slc_cmd}" ]; then
            echo "-- No slc launcher found. Downloading"
            "${repo_dir}"/script/bootstrap_silabs

            slc_cmd=$(_slc_find_launcher "${SLC_INSTALL_DIR}" || true)
        fi

    fi
    set +x
}

cleanup()
{
    if [ "$?" -eq "14" ]; then
        echo "Please make sure Java 11 installed and the JAVA_11_HOME environment variable is set."
    fi
}

trap cleanup EXIT
