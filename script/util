contains()
{
    local search_term=$1
    shift 1
    IFS=" " read -r -a list <<<"$@"
    echo "${list[@]}" | grep -w -q -E "$search_term"
}

die()
{
    echo " ** ERROR: $1"
    exit 1
}

# wget is absent from a stock macOS and from a Windows shell, curl is present on
# both (and on every modern Linux), so use whichever exists instead of requiring
# one particular tool.
download_file()
{
    local url="$1"
    local dest="$2"

    # Land the file only once it is whole. curl and wget both leave whatever
    # arrived behind when a transfer dies, so writing straight to ${dest} means
    # a failed download is indistinguishable from a finished one -- and a
    # caller that recognises an already-present archive takes the truncated
    # remains for a cache hit, forever.
    local part="${dest}.part"
    rm -f "${part}"

    # These archives run to hundreds of MB (Commander alone is 194 MB), long
    # enough that a connection reset mid-transfer is a normal event rather than
    # an edge case -- one was observed dying at 78.9% with curl: (56). Plain
    # --retry does not cover that: it retries transient HTTP responses and
    # timeouts, not a transfer that broke after it started. So ask for
    # --retry-all-errors as well, and space the attempts out so a server
    # shedding load gets a moment to recover.
    if command -v curl > /dev/null 2>&1; then
        # --retry-all-errors landed in curl 7.71 and Ubuntu 20.04 still ships
        # 7.68, where an unknown option is a hard error ("option ... is
        # unknown") that would fail the download outright. Ask curl itself
        # instead of comparing version strings.
        local retry_all=""
        if curl --retry-all-errors --version > /dev/null 2>&1; then
            retry_all="--retry-all-errors"
        fi
        # shellcheck disable=SC2086
        curl -fL --retry 4 ${retry_all} --retry-delay 3 \
            --progress-bar -o "${part}" "${url}" \
            || { rm -f "${part}"; return 1; }
    elif command -v wget > /dev/null 2>&1; then
        wget --tries 4 --waitretry 3 "${url}" -O "${part}" \
            || { rm -f "${part}"; return 1; }
    else
        die "neither curl nor wget is available to download ${url}"
    fi

    mv -f "${part}" "${dest}"
}


# Whether an archive can be read end to end, for a caller deciding whether an
# already-present file is a usable cache entry.
#
# Undecidable is not the same as corrupt: when nothing on the host can test the
# archive, report it good. Discarding a sound one costs a few hundred MB of
# re-download, which is a worse trade than trusting a file that is almost
# always fine.
archive_ok()
{
    local archive="$1"
    local py="" candidate

    case "${archive}" in
        *.zip)
            # unzip is not guaranteed here, for the same reason extract_zip
            # carries a Python path: the CI runner has none.
            if command -v unzip > /dev/null 2>&1; then
                unzip -qt "${archive}" > /dev/null 2>&1 || return 1
                return 0
            fi
            for candidate in python3 python; do
                if command -v "${candidate}" > /dev/null 2>&1; then
                    py="${candidate}"
                    break
                fi
            done
            [ -n "${py}" ] || return 0
            "${py}" -c \
                'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).testzip()' \
                "${archive}" > /dev/null 2>&1 || return 1
            ;;
        *)
            command -v tar > /dev/null 2>&1 || return 0
            tar tf "${archive}" > /dev/null 2>&1 || return 1
            ;;
    esac

    return 0
}

# unzip is not guaranteed: the CI runner has none, and script/bootstrap now
# skips the apt install that would provide one when sudo needs a password.
# Python is always there -- tos.py itself runs on it -- but zipfile.extract
# drops the Unix mode bits, and slc and commander have to come out executable,
# so put them back from the archive entry.
extract_zip()
{
    local zip_file="$1"
    local dest_dir="$2"

    if command -v unzip > /dev/null 2>&1; then
        unzip -q -o "${zip_file}" -d "${dest_dir}"
        return
    fi

    local py=""
    local candidate
    for candidate in python3 python; do
        if command -v "${candidate}" > /dev/null 2>&1; then
            py="${candidate}"
            break
        fi
    done
    if [ -z "${py}" ]; then
        echo " ** ERROR: need either unzip or python to extract ${zip_file}" >&2
        exit 1
    fi

    echo "unzip not found, extracting ${zip_file} with ${py}"
    "${py}" - "${zip_file}" "${dest_dir}" << 'PY'
import os
import sys
import zipfile

archive, dest = sys.argv[1], sys.argv[2]
with zipfile.ZipFile(archive) as zf:
    for entry in zf.infolist():
        path = zf.extract(entry, dest)
        mode = (entry.external_attr >> 16) & 0o777
        if mode:
            os.chmod(path, mode)
PY
}

# Point a link at a directory, replacing whatever currently occupies the path.
#
# Git Bash has no usable `ln -s`: under MSYS's default winsymlinks setting it
# silently falls back to *copying* the target. That is not merely slow here --
# the target is this repository and the link lives inside it, under
# sdks/simplicity_sdk/extension/, so the copy recurses into itself. A later run
# then fails with "cannot overwrite directory" because a real directory is in
# the way, which is how this surfaces.
#
# A directory junction behaves like a symlink for everything SLC does and,
# unlike a native symlink, mklink /J creates one without elevation.
link_dir()
{
    local target="$1"
    local link="$2"

    case "$(uname -s)" in
        MINGW* | MSYS* | CYGWIN*)
            # rmdir unlinks a junction without touching what it points at. It
            # refuses a real directory, so fall back to removing that outright
            # -- that is the recursive copy an earlier run may have left.
            if [ -e "${link}" ] || [ -L "${link}" ]; then
                rmdir "${link}" 2> /dev/null || rm -rf "${link}"
            fi
            # mklink names the link first and the target second, the opposite of
            # ln, and wants native paths. The doubled slashes keep MSYS from
            # rewriting /c and /J as paths.
            cmd //c mklink //J "$(cygpath -w "${link}")" "$(cygpath -w "${target}")" > /dev/null \
                || die "failed to create junction ${link} -> ${target}"
            ;;
        *)
            ln -sfn "${target}" "${link}"
            ;;
    esac
}

# Host tag for the archives Silicon Labs and ARM publish per architecture.
host_arch_tag()
{
    case "$(uname -m)" in
        x86_64 | amd64) echo "x86_64" ;;
        aarch64 | arm64) echo "aarch64" ;;
        armv7* | armv8l) echo "aarch32" ;;
        *) die "unsupported host architecture: $(uname -m)" ;;
    esac
}
