!!omap
- id: siwx917_ai_dev_kit_config
- label: siwx917_ai_dev_kit config
- description: Configuration files for SiWx917 AI Dev kit
- package: platform
- category: Board|Configuration
- quality: experimental
- metadata:
    sbom:
      license: Zlib
- ui_hints:
    visibility: never 
- root_path: "mcu/boards"
- provides:
  - name: siwx917_ai_dev_kit_config
- config_file:
  - path: siwx917_ai_dev_kit/sl_si91x_debug_uc_1_config.h
    condition: [matter]
  - override:
      component: "%extension-wiseconnect3_sdk%board_configuration_headers"
      file_id: RTE_Device_917
    path: siwx917_ai_dev_kit/RTE_Device_917.h
  - override:
      component: "%extension-wiseconnect3_sdk%sl_si91x_led_917"
      file_id: led_config
      instance: led0
    path: siwx917_ai_dev_kit/sl_si91x_led_init_led0_config.h
  - override:
      component: "%extension-wiseconnect3_sdk%sl_si91x_led_917"
      file_id: led_config
      instance: led1
    path: siwx917_ai_dev_kit/sl_si91x_led_init_led1_config.h
  - override:
      component: "%extension-wiseconnect3_sdk%psram_core"
      file_id: psram_pin_config
    path: siwx917_ai_dev_kit/sl_si91x_psram_pin_config.h
  - override:
      component: "%extension-wiseconnect3_sdk%sl_gspi"
      file_id: gspi_common_config
    path: common_config/sl_si91x_gspi_common_config.h
  - override:
      component: "%extension-wiseconnect3_sdk%sl_gspi"
      file_id: gspi_config
    path: common_config/sl_si91x_gspi_config.h
  - override:
      component: "%extension-wiseconnect3_sdk%sl_ssi_instance"
      file_id: ssi_common_config
      instance: primary
    path: common_config/sl_si91x_ssi_primary_common_config.h
  - override:
      component: "%extension-wiseconnect3_sdk%sl_ssi_instance"
      file_id: ssi_common_config
      instance: secondary
    path: common_config/sl_si91x_ssi_secondary_common_config.h
  - override:
      component: "%extension-wiseconnect3_sdk%sl_ssi_instance"
      file_id: ssi_common_config
      instance: ulp_primary
    path: common_config/sl_si91x_ssi_ulp_primary_common_config.h
  - override:
      component: "%extension-wiseconnect3_sdk%sl_ssi_instance"
      file_id: ssi_config
      instance: primary
    path: common_config/sl_si91x_ssi_primary_config.h
  - override:
      component: "%extension-wiseconnect3_sdk%sl_ssi_instance"
      file_id: ssi_config
      instance: secondary
    path: common_config/sl_si91x_ssi_secondary_config.h
  - override:
      component: "%extension-wiseconnect3_sdk%sl_ssi_instance"
      file_id: ssi_config
      instance: ulp_primary
    path: common_config/sl_si91x_ssi_ulp_primary_config.h
    unless: [memlcd_917]
  - override:
      component: "%extension-wiseconnect3_sdk%board_configuration_headers"
      file_id: sl_board_configuration
    path: siwx917_ai_dev_kit/sl_board_configuration.h
  - override:
      component: "%extension-wiseconnect3_sdk%board_configuration_headers"
      file_id: sl_board_control
    path: siwx917_ai_dev_kit/sl_board_control.h
  - override:
      component: "%extension-wiseconnect3_sdk%board_configuration_headers"
      file_id: pin_config
    path: siwx917_ai_dev_kit/pin_config.h
  - override:
      component: "%extension-wiseconnect3_sdk%sl_si91x_button_917"
      file_id: button_config
      instance: btn0
    path: siwx917_ai_dev_kit/sl_si91x_button_init_btn0_config.h
  - override:
      component: "%extension-wiseconnect3_sdk%sl_si91x_button_917"
      file_id: button_config
      instance: btn1
    path: siwx917_ai_dev_kit/sl_si91x_button_init_btn1_config.h
  - override:
      component: "%extension-wiseconnect3_sdk%iostream_si91x"
      file_id: iostream_usart_config
    path: siwx917_ai_dev_kit/sl_iostream_usart_vcom_config.h
  - override:
      component: "%extension-wiseconnect3_sdk%i2s_instance"
      file_id: i2s_config
      instance: i2s0
    path: siwx917_ai_dev_kit/sl_si91x_i2s_init_i2s0_config.h
