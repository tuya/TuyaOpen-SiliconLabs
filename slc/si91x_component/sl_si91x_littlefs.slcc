id: sl_si91x_littlefs
label: Little FS for Common Flash
package: platform
description: >
  A little fail-safe filesystem. This component is used for performing file operations on Common Flash. 
category: Device|Si91x|MCU|Service
quality: production
metadata:
  sbom:
    license: Zlib
component_root_path: 'mcu'
requires:
  - name: emlib_core
  - name: sl_assert
  - name: sl_common
  - name: status
  - name: sl_si91x_wireless
  - name: network_manager
  - name: basic_network_config_manager
  - name: wiseconnect_common
  - name: wifi
  - name: sl_si91x_mcu
  - name: wifi_resources
  - name: freertos
  - name: freertos_heap_4
template_contribution:
  - name: littlefs_enable
    value: true
  - name: max_flash_size
    value: 2088960 #0x1fe000 
define:
  - name: LFS_THREADSAFE     
provides:
  - name: sl_si91x_littlefs